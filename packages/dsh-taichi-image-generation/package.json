{
  "name": "dsh-taichi-image-generation",
  "version": "0.1.0",
  "description": "Taichi account image generation for conversations, presentations and a standalone drawing page.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
