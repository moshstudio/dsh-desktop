    "@deepseek-ai/dsh-sandbox": "^0.1.2-rc.1 || ^0.1.7-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2 || ^0.2.2-rc.1",
